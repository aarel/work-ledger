@page "{id:int}"
@model WorkLedger.Pages.Items.DeleteModel

<h2>Delete Work Item</h2>

<div class="mb-3">
    <p><strong class="hint" data-hint="Displays what will be removed if deletion proceeds.">Title:</strong> @Model.Item.Title</p>
    <p><strong class="hint" data-hint="Description is kept for context; the service drops the entire record permanently.">Description:</strong> @Model.Item.Description</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Item.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
